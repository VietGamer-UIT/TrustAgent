# ==========================================
# TrustAgent Backend - Cấu hình Môi trường
# ==========================================

# --- API Keys ---
# Yêu cầu để chạy được tính năng Legal RAG tổng hợp kết quả tự nhiên.
# Nếu bỏ trống, RAG sẽ trả về nguyên văn bản luật thô.
# Forensics cũng dùng key này (fallback từ GEMINI_API_KEY); thiếu key → MockParser.
GOOGLE_API_KEY="AIzaSy...your-google-gemini-key"
# Tùy chọn — nếu set, Forensics ưu tiên GEMINI_API_KEY
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- App ---
APP_ENV=development

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
# Lưu ý: Khi chạy Docker, host là 'db' (tên service trong docker-compose)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/trustagent_db"

# --- Backend Config ---
PORT=8000
HOST="0.0.0.0"

# --- Debugging ---
LOG_LEVEL="INFO"
